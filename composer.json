{
    "name": "axolotlbucketlabs/npc",
    "type": "pocketmine-plugin",
    "description": "Visual NPC system for Axolotl-PM API 5",
    "license": "MIT",
    "homepage": "https://github.com/AxolotlBucketLabs/NPC",
    "keywords": ["axolotl-pm", "bedrock", "npc", "pocketmine-plugin"],
    "authors": [
        {
            "name": "NhanAZ"
        },
        {
            "name": "AxolotlBucketLabs"
        }
    ],
    "require": {
        "php": "^8.4",
        "axolotl-pm/pocketmine-mp": "~5.51.1",
        "dktapps/pmforms": "~2.3.1"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/AxolotlBucketLabs/pmforms"
        }
    ],
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
