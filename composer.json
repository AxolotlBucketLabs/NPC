{
    "name": "axolotlbucketlabs/npc-build",
    "type": "pocketmine-plugin",
    "description": "Visual NPC system for Axolotl-PM and PocketMine-MP API 5",
    "license": "MIT",
    "require": {
        "axolotl-pm/pocketmine-mp": "~5.51.1",
        "dktapps/pmforms": "~2.3.1"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/AxolotlBucketLabs/pmforms"
        }
    ],
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
